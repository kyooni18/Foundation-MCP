# Transport: stdio for local clients, http for remote MCP clients.
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=8787
MCP_PATH=/mcp
ALLOWED_HOSTS=foundation.example.com,localhost,127.0.0.1
MAX_REQUEST_BYTES=1048576

# Canonical external HTTPS origin. Required when OAuth is enabled.
PUBLIC_BASE_URL=https://foundation.example.com
OAUTH_ENABLED=true
# Password entered on Foundation's approval page during ChatGPT sign-in.
OAUTH_LOGIN_PASSWORD=replace-with-a-long-random-password
OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional compatibility credentials for Codex or direct API clients.
# Full access. FOUNDATION_API_KEY remains a compatibility alias for this value.
FOUNDATION_ADMIN_KEY=replace-with-a-long-random-token
# Restricted to read-only MCP tools.
FOUNDATION_READ_ONLY_KEY=replace-with-a-different-long-random-token

DATABASE_URL=postgresql://foundation:foundation@db:5432/foundation
DATABASE_POOL_SIZE=10
AUTO_MIGRATE=true
ENABLE_AUDIT=true

# none keeps lexical/trigram search fully operational.
# openai supports OpenAI and OpenAI-compatible embedding endpoints.
# ollama uses POST /api/embed.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
