# Foundation MCP 0.3
# Copy to .env and replace every placeholder before remote deployment.

# PostgreSQL used by docker-compose.yml. PostgreSQL is not published to the host.
POSTGRES_DB=foundation
POSTGRES_USER=foundation
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://foundation:replace-with-a-long-random-database-password@db:5432/foundation
DATABASE_POOL_SIZE=10
AUTO_MIGRATE=true
ENABLE_AUDIT=true

# Transport: stdio for local clients, http for remote MCP clients.
# Tool surface: balanced exposes only six compact memory_* tools; full restores low-level atom/admin tools.
MCP_TOOL_PROFILE=balanced
MCP_TRANSPORT=http
HOST=0.0.0.0
PORT=8787
MCP_PATH=/mcp
ALLOWED_HOSTS=foundation.example.com,localhost,127.0.0.1,::1
MAX_REQUEST_BYTES=1048576
REQUEST_RATE_LIMIT_PER_MINUTE=600

# Compatibility bearer credentials. FOUNDATION_API_KEY is still accepted as an
# alias for FOUNDATION_ADMIN_KEY.
FOUNDATION_ADMIN_KEY=replace-with-a-long-random-token
FOUNDATION_READ_ONLY_KEY=replace-with-a-different-long-random-token
# Exact namespaces and trailing-prefix wildcards are supported, for example:
# personal,project:calcite,work:*
FOUNDATION_ADMIN_NAMESPACES=*
FOUNDATION_READ_ONLY_NAMESPACES=*

# OAuth for ChatGPT/remote MCP clients. Existing authorization-code + PKCE,
# dynamic registration, refresh-token, and revocation mechanisms are retained.
PUBLIC_BASE_URL=https://foundation.example.com
OAUTH_ENABLED=true
OAUTH_LOGIN_PASSWORD=replace-with-a-long-random-approval-password
OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_DEFAULT_NAMESPACES=*
OAUTH_RATE_LIMIT_PER_MINUTE=60

# none keeps lexical/trigram search fully operational.
# openai supports OpenAI and OpenAI-compatible embedding endpoints.
# ollama uses POST /api/embed.
# google uses Gemini's batchEmbedContents endpoint.
# openrouter uses its OpenAI-compatible /embeddings endpoint.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers.
# OPENROUTER_SITE_URL=https://foundation.example.com
# OPENROUTER_APP_NAME=Foundation MCP
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_RETRY_MAX=3
EMBEDDING_CACHE_SIZE=2000
EMBEDDING_CACHE_TTL_SECONDS=3600
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4

# Optional smart-memory model. Existing .env files do not need these entries.
# SMART_MODEL_ENABLED, SMART_MODEL, SMART_MODEL_API_KEY, and SMART_MODEL_BASE_URL
# keep their previous meanings; all cost controls below have built-in defaults.
# SMART_MODEL_ENABLED=auto
# SMART_MODEL=gpt-5.6-luna
# SMART_MODEL_API_KEY=
# SMART_MODEL_BASE_URL=https://api.openai.com/v1
# SMART_MODEL_MAX_INPUT_CHARACTERS=3200
# SMART_MODEL_MAX_OUTPUT_TOKENS=320
# SMART_MODEL_LONG_INPUT_THRESHOLD=900
# SMART_MODEL_AMBIGUOUS_LEXICAL_THRESHOLD=0.62
# SMART_MODEL_DUPLICATE_LEXICAL_THRESHOLD=0.93
# SMART_MODEL_CACHE_SIZE=2000
# SMART_MODEL_CACHE_TTL_SECONDS=604800
# SMART_MODEL_TIMEOUT_MS=15000
# SMART_MODEL_DAILY_CALL_BUDGET=32
# SMART_MODEL_DAILY_INPUT_TOKEN_BUDGET=24000

# Context planning and adaptive ranking. Access and feedback weights are kept
# intentionally small to prevent a popularity feedback loop.
CONTEXT_DIVERSITY_LAMBDA=0.78
CONTEXT_RELATION_EXPANSION=true
CONTEXT_RELATION_LIMIT=2
CONTEXT_QUERY_DECOMPOSITION=true
ADAPTIVE_ACCESS_WEIGHT=0.025
ADAPTIVE_FEEDBACK_WEIGHT=0.035

# Operational visibility.
LOG_FORMAT=text
LOG_LEVEL=info
METRICS_ENABLED=false
METRICS_PATH=/metrics

# Low-frequency administrative MCP tools are hidden by default.
EXPOSE_MAINTENANCE_TOOLS=false
# Optional persistent maintenance scheduler. Manual jobs can still be queued
# through the maintenance MCP tool when maintenance tools are exposed.
MAINTENANCE_ENABLED=false
MAINTENANCE_INTERVAL_SECONDS=3600
MAINTENANCE_REEMBED_LIMIT=100
MAINTENANCE_CONSOLIDATION_LIMIT=100
# Archival is opt-in; duplicate consolidation only creates suggestion relations.
MAINTENANCE_ARCHIVE_EXPIRED=false
