# Transport: stdio for local clients, http for remote MCP clients.
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=8787
MCP_PATH=/mcp
ALLOWED_HOSTS=localhost,127.0.0.1
# Full access. FOUNDATION_API_KEY remains a compatibility alias for this value.
FOUNDATION_ADMIN_KEY=replace-with-a-long-random-token
# Optional key restricted to read-only MCP tools.
FOUNDATION_READ_ONLY_KEY=replace-with-a-different-long-random-token
MAX_REQUEST_BYTES=1048576

DATABASE_URL=postgresql://foundation:foundation@db:5432/foundation
DATABASE_POOL_SIZE=10
AUTO_MIGRATE=true
ENABLE_AUDIT=true

# none keeps lexical/trigram search fully operational.
# openai supports OpenAI and OpenAI-compatible embedding endpoints.
# ollama uses POST /api/embed.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
