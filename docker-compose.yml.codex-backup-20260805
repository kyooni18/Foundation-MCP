services:
  db:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_DB: foundation
      POSTGRES_USER: foundation
      POSTGRES_PASSWORD: foundation
    volumes:
      - foundation_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U foundation -d foundation"]
      interval: 5s
      timeout: 5s
      retries: 20
    network_mode: host

  foundation-mcp:
    build: .
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file: .env
    environment:
      MCP_TRANSPORT: http
      DATABASE_URL: postgresql://foundation:foundation@db:5432/foundation
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "8787:8787"
    network_mode: host
volumes:
  foundation_data:

networks:
  main:
